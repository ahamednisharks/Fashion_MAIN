# ---- Server ----------------------------------------------------------------
NODE_ENV=development
PORT=3000
# Comma-separated list of allowed browser origins (the Angular dev server by default).
CORS_ORIGINS=http://localhost:4200
# Log one line per HTTP request (method, path, status, duration).
LOG_REQUESTS=true

# ---- Single-service deployment (Angular app + API on one domain and port) ------
# When the Angular build exists, this server also serves the app: "npm run build" in the project
# root builds both, "npm start" there runs this server. Build folder, relative to Backend/
# (default: ../Frontend/dist/fashion/browser):
# FRONTEND_DIST=
# Behind HTTPS (NODE_ENV=production) cookies are HTTPS-only. To open the app over plain HTTP
# (e.g. http://192.168.1.10:3000 on the shop network), set COOKIE_SECURE=false below.

# ---- PostgreSQL ------------------------------------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
# Database name (letters, digits, underscore). Tests use "<DB_NAME>_test" unless TEST_DB_NAME is set.
DB_NAME=fashion
DB_POOL_MAX=10
DB_SSL=false
# With DB_SSL=true: CA certificate file to verify the server with (cloud databases such as Aiven
# provide one — download it as ca.pem). Empty = encrypted, but the server is not verified.
DB_SSL_CA=

# ---- Authentication ----------------------------------------------------------
# Session ends after this many hours without activity (sliding).
SESSION_IDLE_HOURS=12
# "Keep me signed in" sessions last this many days (sliding).
SESSION_REMEMBER_DAYS=30
# Send cookies only over HTTPS (defaults to true when NODE_ENV=production).
# COOKIE_SECURE=false
# Password for the default "admin" login that `npm run db:migrate` creates when there are no
# users yet (the admin must change it at first sign-in). Default: admin@123
# ADMIN_INITIAL_PASSWORD=
